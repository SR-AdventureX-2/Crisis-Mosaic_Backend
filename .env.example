APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DEBUG=false
AUTO_CREATE_SCHEMA=false

DATABASE_URL=sqlite+aiosqlite:///./data/crisis_mosaic.db
DATA_DIR=./data
STORAGE_ROOT=./data/uploads
CORS_ORIGINS=["http://127.0.0.1:52123","http://localhost:52123"]

JWT_SECRET=replace-with-at-least-48-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=crisis-mosaic
JWT_AUDIENCE=crisis-mosaic-clients
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
INSTALLATION_ID_PEPPER=replace-with-independent-random-pepper
UPLOAD_SIGNING_SECRET=replace-with-independent-random-secret

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-local-password
BOOTSTRAP_OPERATOR_USERNAME=operator
BOOTSTRAP_OPERATOR_PASSWORD=replace-with-another-strong-local-password

AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_COMPLETIONS_PATH=/chat/completions
AI_REPORT_MODEL=gpt-4.1-mini
AI_VISION_MODEL=gpt-4.1-mini
AI_BRIEF_MODEL=gpt-4.1-mini
AI_SUPPORTS_JSON_SCHEMA=true
AI_REPORT_TIMEOUT_SECONDS=5
AI_CONFLICT_TIMEOUT_SECONDS=10
AI_BRIEF_TIMEOUT_SECONDS=15
AI_PROMPT_VERSION=p0-v1
ENABLE_LEGACY_DEMO_AI=false

MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_ATTACHMENTS_PER_REPORT=5
UPLOAD_INTENT_MINUTES=10
SIGNED_DOWNLOAD_MINUTES=10
MALWARE_SCANNER=windows_defender
DEFENDER_COMMAND=
MALWARE_SCAN_TIMEOUT_SECONDS=60

MAP_DEFAULT_LATITUDE=30.2741
MAP_DEFAULT_LONGITUDE=120.1551
MAP_DEFAULT_ZOOM=12
MAP_MAX_POINTS=500
MAP_MAX_BBOX_AREA_DEGREES=4
COORDINATE_ALGORITHM_VERSION=gcj02-v1

IDEMPOTENCY_HOURS=24
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_SESSIONS_PER_MINUTE=10
RATE_LIMIT_REPORT_CREATES_PER_MINUTE=6
RATE_LIMIT_REPORT_UPDATES_PER_MINUTE=12
RATE_LIMIT_AI_REFINEMENTS_PER_MINUTE=6
RATE_LIMIT_AI_BRIEFS_PER_MINUTE=6
REALTIME_REPLAY_HOURS=24
REALTIME_HEARTBEAT_SECONDS=25
REALTIME_QUEUE_SIZE=1000
JOB_LEASE_SECONDS=60
JOB_POLL_SECONDS=0.5
JOB_MAX_ATTEMPTS=3
DIRECTED_MIN_VALID_ANSWERS=2
CONFLICT_RADIUS_M=200
CONFLICT_WINDOW_HOURS=6
LOCATION_FUTURE_TOLERANCE_MINUTES=5
MAX_LOCATION_ACCURACY_M=5000
BUSINESS_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
RETENTION_CLEANUP_HOURS=24
